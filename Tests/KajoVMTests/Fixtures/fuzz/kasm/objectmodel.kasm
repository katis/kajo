; --- unwinding (Smalltalk-80 / Squeak's protocol over the VM's primitives)

; aBlock ensure: unwindBlock. temp 0 the unwind block (tempAt: 1), temp 1
; complete (tempAt: 2), temp 2 the result.
method BlockClosure ensure: temps=2 unwind
  push_self
  send value 0
  store_temp 2
  push_temp 1
  is_nil
  jump_if_false done
  push_true
  store_temp 1
  push_temp 0
  send value 0
  pop
done:
  push_temp 2
  return_top
end

; The VM sends this to the home Context of a non-local return that would
; cross an unwind mark: return the value to the home's sender, running the
; unwind blocks on the way.
method Context aboutToReturn:through: temps=0
  push_self
  send sender 0
  push_temp 0
  push_temp 1
  send resume:through: 2
  return_top
end

; Unwind thisContext to self, running each pending unwind block from
; firstUnwind on, and answer value as the result of self's last send.
; temps: 0 value, 1 firstUnwind, 2 ctxt, 3 unwindBlock
method Context resume:through: temps=2
  push_temp 1
  store_temp 2
loop:
  push_temp 2
  is_nil
  jump_if_true finish
  push_temp 2
  push_int 2
  send tempAt: 1
  is_nil
  jump_if_false next
  push_temp 2
  push_int 2
  push_true
  send tempAt:put: 2
  pop
  push_temp 2
  push_int 1
  send tempAt: 1
  store_temp 3
  push_this_context
  push_temp 2
  send terminateTo: 1
  pop
  push_temp 3
  send value 0
  pop
next:
  push_temp 2
  push_self
  send findNextUnwindContextUpTo: 1
  store_temp 2
  jump loop
finish:
  push_this_context
  push_self
  send terminateTo: 1
  pop
  push_temp 0
  return_top
end

; Return value from self to its sender, unwinding.
method Context return: temps=0
  push_self
  send sender 0
  push_temp 0
  push_this_context
  push_self
  send findNextUnwindContextUpTo: 1
  send resume:through: 2
  return_top
end

; --- exceptions: 0 signalContext, 1 handlerContext, 2 tag
class Exc Object 3
class ExcA Exc 3
class ExcB Exc 3

; protected on: anExceptionClass do: aHandlerBlock (handler mark).
; temps: 0 exception class (tempAt: 1), 1 handler block (tempAt: 2)
method BlockClosure on:do: temps=0 handler
  push_self
  send value 0
  return_top
end

method Exc tag temps=0
  push_ivar 2
  return_top
end

method Exc tag: temps=0
  push_temp 0
  store_ivar 2
  return_self
end

; signal: the handler block runs on top of the signaling stack; falling
; off its end returns its value from on:do:. Unhandled: nil.
; temps: 0 ctx, 1 handler value
method Exc signal temps=2
  push_this_context
  store_ivar 0
  push_this_context
  send sender 0
  send findNextHandlerContextStarting 0
  store_temp 0
loop:
  push_temp 0
  is_nil
  jump_if_true unhandled
  push_temp 0
  push_int 1
  send tempAt: 1
  push_self
  class_of
  identical
  jump_if_false next
  push_temp 0
  store_ivar 1
  push_temp 0
  push_int 2
  send tempAt: 1
  push_self
  send value: 1
  store_temp 1
  push_self
  push_temp 1
  send return: 1
  return_top
next:
  push_temp 0
  send sender 0
  send findNextHandlerContextStarting 0
  store_temp 0
  jump loop
unhandled:
  push_nil
  return_top
end

method Exc return: temps=0
  push_ivar 1
  push_temp 0
  send return: 1
  return_top
end

method Exc resume: temps=0
  push_ivar 0
  push_temp 0
  send return: 1
  return_top
end
