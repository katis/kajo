"The compiler in Smalltalk against the bootstrap compiler: every method of every class of the image, compiled from its recorded source, must equal the installed method (bytecodes, literals, blocks, pragmas, header). Any difference would be listed in knownDifferences with its reason; there is none."
Class {
	#name : #CompilerTest,
	#superclass : #TestCase
}

{ #category : #accessing }
CompilerTest >> knownDifferences [
	"Methods whose Smalltalk-compiled form may differ from the bootstrap's, with why. Empty: the two compilers agree on every kernel method."
	^ #()
]

{ #category : #accessing }
CompilerTest >> testALongChainIsWalkedByALoop [
	"The review fixes, part 2, item 1 (kernel.F6): a chain of 120 000 unary sends (on 18e274f 120 000 overflowed the stack, 60 000 did not) is analysed and generated by loops, as the bootstrap's Compiler.chain does: the answer is CompiledCode or a CompileError, never a stack overflow. A short chain still compiles to its sends in order."
	| s answer code |
	s := WriteStream on: String new.
	s nextPutAll: 'foo ^ 1'.
	120000 timesRepeat: [s nextPutAll: ' abs'].
	answer := [Compiler compile: s contents in: Object] on: CompileError do: [:e | #refused].
	self assert: (answer == #refused or: [answer isKindOf: CompiledCode]).
	code := Compiler compile: 'foo: x ^ (x abs max: 3) negated printString size' in: Object.
	self assert: ((code literals select: [:l | l isSymbol]) asArray first: 4) = #(#abs #max: #negated #printString)
]

{ #category : #accessing }
CompilerTest >> testBlocksAndCaptures [
	| code block |
	code := Compiler compile: 'f: a | t | t := 0. a do: [:e | t := t + e]. ^ [t]' in: Object.
	block := code literals detect: [:l | l isKindOf: CompiledCode].
	self assert: block isBlock.
	self assert: block numCopied = 1.
	self assert: (code bytecodes first: 2) = (ByteArray with: (BytecodeGenerator number: #pushNewArray) with: 1)
]

{ #category : #accessing }
CompilerTest >> testCompiledCodeRunsTheSame [
	| code |
	code := Compiler compile: 'sum: n | s | s := 0. 1 to: n do: [:i | s := s + i]. ^ s' in: Object.
	self assert: code numArgs = 1.
	self assert: code literals size = 1.
	self assert: (code literals first isKindOf: ByteArray).
	self assert: (code flags bitAnd: 16) = 16.
	self assert: code bytecodes first = (BytecodeGenerator number: #pushInt)
]

{ #category : #accessing }
CompilerTest >> testEncodingLimitsAreCompileErrors [
	"The review fixes, part 2, item 5 (kernel.F14): the generator refuses an operand past its field with a CompileError naming the limit, as the assembler does (a keyword send of 256 arguments was ByteArray at:put:'s Error); the make primitive refuses more than 32 760 bytes of bytecode before its verifier, and a CompiledCode whose integer fields are extreme is refused, never a trap."
	| src code e |
	src := WriteStream on: String new.
	src nextPutAll: 'f ^ self'.
	1 to: 256 do: [:i | src nextPutAll: ' k'; print: i; nextPutAll: ': 1'].
	e := [Compiler compile: src contents in: Object. nil] on: CompileError do: [:x | x messageText].
	self assert: (e notNil and: [e includesSubstring: '255']).
	code := CompiledCode new setSelector: #f bytecodes: (ByteArray new: 32761) literals: #() numArgs: 0 numTemps: 0 maxStack: 1 primitive: 0 flags: 0 numCopied: 0.
	e := [code makeMethodIn: Object. nil] on: CompileError do: [:x | x messageText].
	self assert: (e notNil and: [e includesSubstring: 'more than 32760 bytes']).
	#(-4611686018427387904 4611686018427387903 -1) do: [:n |
		#(1 2 3 4 5 6) do: [:field | | f |
			f := Array new: 6 withAll: 0.
			f at: 3 put: 1.
			f at: field put: n.
			code := CompiledCode new setSelector: #f bytecodes: #[14] literals: #() numArgs: (f at: 1) numTemps: (f at: 2) maxStack: (f at: 3) primitive: (f at: 4) flags: (f at: 5) numCopied: (f at: 6).
			self should: [code makeMethodIn: Object] raise: CompileError]]
]

{ #category : #accessing }
CompilerTest >> testEveryMethodCompilesAsTheBootstrapDid [
	<slow>
	| checked failures |
	checked := 0.
	failures := OrderedCollection new.
	Smalltalk allBehaviors do: [:c |
		c methodsDo: [:m | | src d |
			src := Smalltalk sourceOf: m.
			self assert: src notNil description: 'no source for ' , m printString.
			(self knownDifferences includes: m printString) ifFalse: [
				d := [(Compiler compile: src in: c) matches: m] on: Error do: [:e | 'error: ' , e messageText].
				d ifNotNil: [:x | failures add: m printString , ': ' , x].
				checked := checked + 1]]].
	self assert: checked > 1000.
	self assert: failures isEmpty description: (failures isEmpty ifTrue: [''] ifFalse: [failures size printString , ' differ, the first: ' , failures first])
]

{ #category : #accessing }
CompilerTest >> testIdentifiersFollowTheBootstrapsRule [
	"The review fixes, part 2, item 2 (kernel.F7): an identifier starts with a letter (ASCII, _ or Unicode alphabetic) and continues with letters, digits and other numeric scalars, the bootstrap's rule through primitive 171. U+00D7, U+00B7, U+2192, U+1F600, U+00A0 and a combining mark are refused at the start and inside; a non-ASCII digit only continues one; letters do both. ReviewFixesPart2Tests checks the bootstrap agrees on each."
	| accepts |
	accepts := [:id | [Compiler compile: 'f | ' , id , ' | ' , id , ' := 3. ^ ' , id in: Object. true] on: CompileError do: [:e | false]].
	#(16rD7 16rB7 16r2192 16r1F600 16rA0 16r301) do: [:v | | c |
		c := (Character value: v) asString.
		self deny: (accepts value: c , 'x').
		self deny: (accepts value: 'x' , c , 'y')].
	self deny: (accepts value: (Character value: 16r663) asString , 'x').
	self assert: (accepts value: 'x' , (Character value: 16r663) asString).
	#(16rE9 16r3BB) do: [:v | | c |
		c := (Character value: v) asString.
		self assert: (accepts value: c , 'x').
		self assert: (accepts value: 'x' , c , 'y')].
	self assert: (Scanner identifierClassOf: 16rE9) = 1.
	self assert: (Scanner identifierClassOf: 16r663) = 2.
	self assert: (Scanner identifierClassOf: 16rD7) = 0.
	self assert: (Scanner identifierClassOf: -1) = 0.
	self assert: (Scanner identifierClassOf: 16r110000) = 0
]

{ #category : #accessing }
CompilerTest >> testIntegersAndPrimitivesAsTheBootstrapDecides [
	"The review fixes, part 2, item 6 (kernel.F15): inlining and the hidden limit temp ask whether a literal is a SmallInteger, as the bootstrap's .integer does (a LargeInteger literal is not one), and <primitive:> takes a SmallInteger 1...255, once. ReviewFixesPart2Tests compares the two compilers over a corpus of such methods."
	| code |
	code := Compiler compile: 'f 1 to: 10 by: 4611686018427387904 do: [:i | i]' in: Object.
	self assert: (code literals includes: #to:by:do:).
	code := Compiler compile: 'f 1 to: 100000000000000000000 do: [:i | i]' in: Object.
	self assert: code numTemps = 2.
	code := Compiler compile: 'f 1 to: 10 do: [:i | i]' in: Object.
	self assert: code numTemps = 1.
	#('f <primitive: 0> ^ 1' 'f <primitive: 256> ^ 1' 'f <primitive: 1> <primitive: 2> ^ 1' 'f <primitive: ''x''> ^ 1' 'f <primitive: 4611686018427387904> ^ 1') do: [:src |
		self should: [Compiler compile: src in: Object] raise: CompileError].
	self assert: (Compiler compile: 'f <primitive: 255> ^ 1' in: Object) primitive = 255
]

{ #category : #accessing }
CompilerTest >> testParserErrors [
	#('f ^' 'f [' 'f x := 1' 'f: a a := 1' 'f | a a |' 'f ^ 1. 2' 'f #(' 'f ''abc' 'f "x' 'f ^ 16r' 'f ^ (1' 'f ^ [:x 1]' 'f ^ #[256]' 'f ^ a ; b') do: [:src |
		self should: [Compiler compile: src in: Object] raise: CompileError]
]

{ #category : #accessing }
CompilerTest >> testScannerTokens [
	| s kinds |
	s := Scanner on: 'foo: x ^ #(1 $a) , 16r1F + 2.5e3 - -3 := ''it''''s'' #at:put: [:y | y]'.
	kinds := OrderedCollection new.
	[s next == #end] whileFalse: [kinds add: s kind -> s value].
	self assert: (kinds collect: [:a | a key]) asArray = #(#keyword #identifier #caret #literalArrayStart #integer #character #rightParen #binary #integer #binary #float #binary #binary #integer #assign #string #symbol #leftBracket #colon #identifier #bar #identifier #rightBracket).
	self assert: (kinds at: 9) value = 31.
	self assert: (kinds at: 11) value = 2500.0.
	self assert: (kinds at: 16) value = 'it''s'
]
