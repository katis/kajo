method isFraction ^<Boolean>
method isInteger ^<Boolean>
method isLiteral ^<Boolean>
method isNil ^<Boolean>
method isNumber ^<Boolean>
method isString ^<Boolean>
method isSymbol ^<Boolean>
method notNil ^<Boolean>
# the class side every class shares (Behavior's instance side, seen from a class)
meta new ^<Instance>
meta new: <Integer> ^<Instance>
meta basicNew ^<Instance>
meta basicNew: <Integer> ^<Instance>
meta name ^<String>
meta superclass ^<Behavior | Nil>
meta selectors ^<Array[Symbol]>
meta includesSelector: <Symbol> ^<Boolean>
meta canUnderstand: <Symbol> ^<Boolean>
meta inheritsFrom: <Behavior> ^<Boolean>
meta includesBehavior: <Behavior> ^<Boolean>
meta allInstances ^<Array[Instance]>
meta instanceCount ^<Integer>
meta compiledMethodAt: <Symbol> ^<CompiledMethod>
meta lookupSelector: <Symbol> ^<CompiledMethod | Nil>
