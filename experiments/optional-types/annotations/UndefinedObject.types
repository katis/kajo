class UndefinedObject
method isNil ^<Boolean>
method notNil ^<Boolean>
method isEmptyOrNil ^<Boolean>
method isLiteral ^<Boolean>
method printOn: <WriteStream> ^<Self>
method shallowCopy ^<Self>
method ifNotNil: <Dynamic> ^<Nil>
method ifNil: <[^R]> ^<R>
