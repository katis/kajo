# An Interval of the receiver of to: (1 to: 5 is an Interval[Integer], 1 to: 2 by: 0.5 an Interval[Number]);
# its collect: and select: answer Arrays (species).
class Interval[N]
ivar start <N>
ivar stop <Number>
ivar step <Number>
method at: <Integer> ^<N>
method collect: <[N, ^X]> ^<Array[X]>
method select: <[N, ^Boolean]> ^<Array[N]>
method do: <[N, ^Dynamic]> ^<Self>
method first ^<N>
method last ^<N>
method increment ^<Number>
method size ^<Integer>
method species ^<Behavior>
method setFrom: <Number> to: <Number> by: <Number> ^<Self>
meta from: <X> to: <Number> ^<Instance[X]>
meta from: <X> to: <Number> by: <Number> ^<Instance[X]>
