; Scenario code for the AppKit app (SPEC.md "Scenarios"). Loaded after
; lib.kasm and ../../vm-language-bench/kernels/alloc.kasm.
; Globals: 1 = event Semaphore, 2 = counter Semaphore (S5).

; --- The UI Process: wait for an event, ~50 us of work, update the label.
; t0 = spin count, t1 = event Semaphore, t2 = handled count
method UndefinedObject uiLoop: temps=2
  push_nil
  push_int 1
  send globalAt: 1
  store_temp 1
  push_int 0
  store_temp 2
loop:
  push_temp 1
  send wait 0
  pop
  push_nil
  send nextEvent 0
  pop
  push_nil
  push_temp 0
  send spin: 1
  pop
  push_temp 2
  push_int 1
  add
  store_temp 2
  push_nil
  push_temp 2
  send setLabel: 1
  pop
  jump loop
end

; --- S2/S7: [true] whileTrue: []
method UndefinedObject hog temps=0
loop:
  push_true
  jump_if_true loop
  return_self
end

; --- S3: recurse with t0 spins of work per level until the stack overflows.
method UndefinedObject deep: temps=0
  push_nil
  push_temp 0
  send spin: 1
  pop
  push_nil
  push_temp 0
  send deep: 1
  return_top
end

; Fork a main-affine `deep:` with an exit Semaphore, wait for it to die, repeat.
; t0 = spins per level, t1 = exit Semaphore
method UndefinedObject deepSupervisor: temps=1
loop:
  push_nil
  send newSemaphore 0
  store_temp 1
  push_nil
  push_lit #deep:
  push_temp 0
  push_int 1
  push_true
  push_temp 1
  send fork:with:priority:main:exit: 5
  pop
  push_temp 1
  send wait 0
  pop
  jump loop
end

; --- S4: alloc.kasm's binary-trees body forever (40 depth-16 trees per round).
method UndefinedObject allocLoop temps=0
loop:
  push_nil
  push_int 0
  push_int 8
  send run:of: 2
  pop
  jump loop
end

; --- S5: [nil delay: ms signal: s. s wait. counter signal] repeat
; t0 = ms, t1 = own Semaphore, t2 = counter Semaphore
method UndefinedObject delayLoop: temps=2
  push_nil
  send newSemaphore 0
  store_temp 1
  push_nil
  push_int 2
  send globalAt: 1
  store_temp 2
loop:
  push_nil
  push_temp 0
  push_temp 1
  send delay:signal: 2
  pop
  push_temp 1
  send wait 0
  pop
  push_temp 2
  send signal 0
  pop
  jump loop
end

; --- S6: [spin ~1 ms. nil setLabel: n (hops to main). nil detachFromMain] repeat
; t0 = spin count, t1 = n
method UndefinedObject hopper: temps=1
  push_int 0
  store_temp 1
loop:
  push_nil
  push_temp 0
  send spin: 1
  pop
  push_temp 1
  push_int 1
  add
  store_temp 1
  push_nil
  push_temp 1
  send setLabel: 1
  pop
  push_nil
  send detachFromMain 0
  pop
  jump loop
end
