; Library for the ui-thread-scheduling experiment. Loaded after
; ../../vm-language-bench/kernels/prelude.kasm. Primitive numbers: SPEC.md
; "Primitives added".

method UndefinedObject globalAt: temps=0 prim=14
end
method UndefinedObject globalAt:put: temps=0 prim=15
end
method Object fork:with:priority:main:exit: temps=0 prim=20
end
method UndefinedObject yield temps=0 prim=21
end
method Semaphore wait temps=0 prim=22
end
method Semaphore signal temps=0 prim=23
end
method Process terminate temps=0 prim=24
end
method UndefinedObject delay:signal: temps=0 prim=25
end
method UndefinedObject readFile:signal: temps=0 prim=26
end
method UndefinedObject ioResult: temps=0 prim=27
end
method UndefinedObject nextEvent temps=0 prim=28
